# SentinelAI Platform Configuration Template
# DO NOT COMMIT REAL PRODUCTION SECRETS TO SOURCE CONTROL

# Application & Environment
PROJECT_NAME="SentinelAI Security Intelligence Platform"
ENVIRONMENT=development
API_V1_STR=/api/v1

# Security & Cryptography
# Generate a strong 256-bit random key in production: openssl rand -hex 32
SECRET_KEY=09d25e094faa6ca2556c818166b7a9563b93f7099f6f0f4caa6cf63b88e8d3e7
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Database Connection
# SQLite default for local zero-dependency development:
DATABASE_URL=sqlite:///./sentinelai.db
# PostgreSQL for production / Docker Compose:
# DATABASE_URL=postgresql://sentinel_user:sentinel_password@postgres:5432/sentinelai

# Redis & Celery Task Queue
REDIS_URL=redis://localhost:6379/0

# Bounded AI Security Intelligence Layer
AI_PROVIDER=mock
AI_MODEL_NAME=sentinel-security-reasoner
AI_API_KEY=
AI_TOKEN_BUDGET=2000
AI_REQUEST_TIMEOUT_SECONDS=30

# Scanner Sandbox Limits
SCAN_EXECUTION_TIMEOUT_SECONDS=300
MAX_ARCHIVE_SIZE_BYTES=104857600
MAX_ARCHIVE_FILES=5000
ALLOW_LOCAL_TARGETS=false
